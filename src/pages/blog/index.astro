---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { blogSchema, internalUrl, webPageSchema } from '../../structured-data';
import { SITE_DESCRIPTION, SITE_TITLE, withBase } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const site = Astro.site!;
const blogUrl = internalUrl('/blog/', site);
const pageSchema = [
	webPageSchema({
		site,
		url: blogUrl,
		name: 'El blog',
		description: SITE_DESCRIPTION,
		mainEntity: { '@id': `${blogUrl}#blog` },
	}),
	blogSchema(
		site,
		posts.map((post) => internalUrl(`/blog/${post.id}/`, site)),
	),
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} schema={pageSchema} />
		<style>
			main {
				width: 960px;
			}
			.page-heading {
				margin-bottom: 2rem;
			}
			.page-heading h1 {
				margin: 0.4rem 0 0;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 0.75rem);
			}
			ul li:first-child {
				width: 100%;
			}
			.card {
				display: block;
				height: 100%;
				overflow: hidden;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: var(--radius);
				box-shadow: var(--shadow);
				text-decoration: none;
				transition:
					transform 0.25s ease,
					box-shadow 0.25s ease,
					border-color 0.25s ease;
			}
			.card:hover {
				transform: translateY(-4px);
				border-color: var(--border-strong);
				box-shadow: var(--shadow-hover);
			}
			.image-frame {
				position: relative;
				overflow: hidden;
				border-bottom: 1px solid var(--border);
			}
			.image-frame::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, transparent 60%, rgba(7, 27, 51, 0.18));
				pointer-events: none;
			}
			.image-frame img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 0;
				transition: transform 0.4s ease;
			}
			.card:hover .image-frame img {
				transform: scale(1.03);
			}
			.card-body {
				padding: 1.25rem 1.5rem 1.5rem;
			}
			.tag {
				margin: 0 0 0.6rem;
				font-family: var(--mono);
				font-size: 0.7rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent);
			}
			.title {
				margin: 0 0 0.5rem;
				color: var(--heading);
				line-height: 1.15;
				transition: color 0.2s ease;
			}
			ul li:first-child .title {
				font-size: 2rem;
			}
			.date {
				margin: 0;
				font-family: var(--mono);
				font-size: 0.8rem;
				letter-spacing: 0.04em;
				color: var(--muted);
			}
			.card:hover .title,
			.card:hover .date {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				main {
					width: 100%;
				}
				ul {
					gap: 1rem;
				}
				ul li,
				ul li:first-child {
					width: 100%;
				}
				ul li:first-child .title {
					font-size: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-heading">
				<p class="eyebrow">ÍNDICE / ENTRADAS</p>
				<h1>El blog</h1>
			</div>
			<section>
				<ul>
					{posts.map((post, index) => (
						<li>
							<a class="card" href={withBase(`/blog/${post.id}/`)}>
								{post.data.heroImage && (
									<div class="image-frame">
										<Image
											width={720}
											height={360}
											src={post.data.heroImage}
											alt={`Portada de ${post.data.title}`}
										/>
									</div>
								)}
								<div class="card-body">
									<p class="tag">{String(index + 1).padStart(2, '0')} / ARQUITECTURA</p>
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
