---
import { SITE_TITLE, withBase } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href={withBase('/')} aria-label={SITE_TITLE}>
			<span class="brand-mark" aria-hidden="true">A</span>
			<span class="brand-text">{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href={withBase('/')}>Inicio</HeaderLink>
			<HeaderLink href={withBase('/blog/')}>Blog</HeaderLink>
			<HeaderLink href={withBase('/about/')}>Acerca de mí</HeaderLink>
		</div>
		<div class="social-links">
			<a
				href="https://github.com/josemcnieto/blog-astro-2"
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="sr-only">Repositorio del blog en GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(247, 251, 255, 0.85);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--border);
	}
	header::after {
		content: '';
		position: absolute;
		bottom: -1px;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(11, 95, 255, 0.45), rgba(0, 184, 217, 0.35), transparent);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		max-width: 1120px;
		margin: 0 auto;
		padding: 0.7em 1.5em;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.7em;
		color: var(--heading);
		font-weight: 700;
		letter-spacing: -0.02em;
		text-decoration: none;
		white-space: nowrap;
	}
	.brand:hover {
		color: var(--heading);
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 9px;
		background: linear-gradient(135deg, var(--accent), var(--cyan));
		box-shadow: 0 0 18px rgba(11, 95, 255, 0.35);
		color: #fff;
		font-family: var(--mono);
		font-size: 0.9rem;
		line-height: 1;
	}
	.internal-links {
		display: flex;
		gap: 0.2em;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links a {
		padding: 0.5em;
		border-radius: 10px;
		color: var(--muted);
		transition: color 0.2s ease, background-color 0.2s ease;
	}
	.social-links a:hover {
		color: var(--accent);
		background: rgba(11, 95, 255, 0.08);
	}
	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			justify-content: center;
			padding: 0.6em 1em;
		}
		.brand-text {
			font-size: 0.9rem;
		}
		.internal-links {
			order: 3;
			width: 100%;
			justify-content: center;
		}
		.social-links {
			display: none;
		}
	}
</style>
