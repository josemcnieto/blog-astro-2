---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.slice(base.length).replace(/\/+$/, '') || '/';
const hrefWithoutBase = href.startsWith(base) ? href.slice(base.length) : href;
const normalizedHref = hrefWithoutBase.replace(/\/+$/, '') || '/';
const firstSegment = pathname.split('/').filter(Boolean)[0] ?? '';
const isActive = normalizedHref === pathname || normalizedHref === `/${firstSegment}`;
---

<a href={href} class:list={['nav-link', className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	.nav-link {
		display: inline-block;
		padding: 0.45em 0.9em;
		border: 1px solid transparent;
		border-radius: 999px;
		color: var(--muted);
		font-size: 0.92rem;
		text-decoration: none;
		transition:
			color 0.2s ease,
			background-color 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.nav-link:hover {
		color: var(--accent);
		background: rgba(11, 95, 255, 0.07);
	}
	.nav-link.active {
		color: var(--accent);
		background: rgba(11, 95, 255, 0.1);
		border-color: var(--border-strong);
		box-shadow: 0 0 16px rgba(11, 95, 255, 0.12);
		font-weight: 700;
	}
</style>
