---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { licenseUrl } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	imageCredit,
	imageLicense,
	imageSource,
} = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				margin: 0;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-width: 1020px;
				margin: 0 auto;
				border: 1px solid var(--border);
				box-shadow: var(--shadow);
			}
			.hero-image figcaption {
				max-width: 1020px;
				margin: 0.6rem auto 0;
				padding: 0 1em;
				font-family: var(--mono);
				font-size: 0.72rem;
				letter-spacing: 0.02em;
				color: var(--muted);
				text-align: right;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--text);
			}
			.title {
				margin-bottom: 2em;
				padding: 2em 0 1em;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0.5em 0;
			}
			.date {
				margin: 0;
				font-family: var(--mono);
				font-size: 0.8rem;
				letter-spacing: 0.1em;
				color: var(--muted);
			}
			.divider {
				height: 1px;
				margin: 1.5em auto 0;
				max-width: 160px;
				background: linear-gradient(90deg, transparent, var(--accent), var(--cyan), transparent);
			}
			.last-updated-on {
				display: inline-block;
				margin-top: 1em;
				padding: 0.3em 0.9em;
				border: 1px solid var(--border);
				border-radius: 999px;
				background: var(--surface);
				font-family: var(--mono);
				font-size: 0.72rem;
				letter-spacing: 0.04em;
				color: var(--muted);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<figure class="hero-image">
					{
						heroImage && (
							<Image
								width={1020}
								height={510}
								src={heroImage}
								alt={`${title} — fotografía de arquitectura`}
							/>
						)
					}
					{
						imageCredit && (
							<figcaption>
								Foto:{' '}
								{imageSource ? (
									<a href={imageSource} target="_blank" rel="noopener noreferrer">
										{imageCredit}
									</a>
								) : (
									imageCredit
								)}
								{imageLicense && (
									<>
										{' · '}
										<a href={licenseUrl(imageLicense)} target="_blank" rel="noopener noreferrer">
											{imageLicense}
										</a>
									</>
								)}
							</figcaption>
						)
					}
				</figure>
				<div class="prose">
					<div class="title">
						<p class="date"><FormattedDate date={pubDate} /></p>
						<h1>{title}</h1>
						<div class="divider"></div>
						{updatedDate && (
							<p class="last-updated-on">
								Actualizado el <FormattedDate date={updatedDate} />
							</p>
						)}
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
